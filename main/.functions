# -*- mode: sh -*-

# Set Title
function set-title {
  case $TERM in
    tmux|screen)
      if [ -n "$TMUX" ]; then
        tmux rename-window -t${TMUX_PANE} $*
      else
        printf "\ek$*\e\\"
      fi
      ;;
    alacritty*|xterm*|cygwin*)
      printf "\033]0;$*\007"
      ;;
  esac
}

################################################################################
# fix-agent - from Joe's https://gist.github.com/joegallo/84df64e178a5ba25899b
# Re-point a stale shell (tmux, long-lived ssh session) at the newest live agent
# socket. Looks in /tmp (bare ssh-agent / forwarded agents) and in
# $XDG_RUNTIME_DIR (systemd + gnome-keyring on modern Linux).
function agent-sockets
{
    find -L /tmp "${XDG_RUNTIME_DIR:-/run/user/$UID}" -maxdepth 3 -uid $UID -type s \
        \( -path "*ssh*/agent.*" -o -path "*/gcr/ssh" -o -path "*launch*/Listeners" \) 2>/dev/null
}

function find-agent
{
    local socks; socks=$(agent-sockets)
    if [[ -z "$socks" ]]; then
        echo "no agent found" >&2
        return 1
    fi
    printf "%s\n" "$socks" | tr '\n' '\0' | xargs -0 /bin/ls -t1 | head -1
}

function fix-agent
{
    local sock; sock="$(find-agent)" || return 1
    export SSH_AUTH_SOCK="$sock"
    ssh-add -l > /dev/null
}

# Make sure SSH_AUTH_SOCK points at a usable agent. On macOS (launchd) and
# systemd desktops (gnome-keyring's gcr-ssh-agent) the session already exports
# one, so only fall back if nothing usable is set. Prefer reusing an existing
# agent over spawning a new one per shell.
function ensure-ssh-agent
{
    [[ -n "$SSH_AUTH_SOCK" && -S "$SSH_AUTH_SOCK" ]] && return 0
    if [[ -S "${XDG_RUNTIME_DIR}/gcr/ssh" ]]; then
        export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/gcr/ssh"
    elif command -v keychain > /dev/null 2>&1; then
        eval "$(keychain --eval --agents ssh 2>/dev/null)"
    elif ! fix-agent 2>/dev/null; then
        eval "$(ssh-agent)" > /dev/null
    fi
}

################################################################################

# Sources VAR=VALUE lines in a docker-compose .env file as exported
# shell environment variables
function source_env
{
    local env_file=.env
    if [[ $# -ge 1 ]] ; then
        if [[ -f $1 ]] ; then
            env_file=$1
        else
            echo "$1 doesn't exist" >&2
            return 1
        fi
    fi

    while IFS="" read -r line || [ -n "$line" ]
    do
        if [[ "$line" =~ ^[^#]+=.* ]] ; then
            echo "Exporting $line"
            export $line
        fi
    done < $env_file
}

################################################################################
# Docker

function docker_run_shell
{
    local image=$1
    if [[ ! -z $(docker images -q $image) ]] ; then
        docker run --rm -it $image /bin/sh -c "which bash && bash || sh"
    else
        echo "$image doesn't exist or isn't pulled" >&2
        return 1
    fi
}
