# -*- mode: sh -*-

# Python
command -v python3 >/dev/null 2>&1 && alias python='python3'

# Emacsclient
alias e='emacsclient -t -a ""'

# Make sure ls has colors and defaults to -h
if ls --color -d . >/dev/null 2>&1; then
    alias ls='ls --color=auto -h'
    alias ll='ls --color=auto -lh'
    alias l='ls --color=auto -lah'
else
    alias ls='ls -h'
    alias ll='ls -lh'
    alias l='ls -lah'
fi

# Jira
alias j='open https://improbableio.atlassian.net/browse/$(git rev-parse --abbrev-ref HEAD)'

# Docker
alias dr='docker run -it --rm'
alias drs='docker_run_shell'  # see .functions
alias drm='docker rm $(docker ps -a -f status=exited -q)'

# Kubernetes
alias k='kubectl'
alias kns='kubens'
alias kctx='kubectx'
alias k9s='k9s -A --logoless'

# Git
alias gco='git checkout'
alias gst='git status'
alias gpr='git pull --rebase'  # Note possible collision with `gpr` command...
alias gf='git fetch -a'

# Rush
alias rbt='rush build --to .'

# Tmux
alias tls='tmux list-sessions'
trs() {
  [ -z "$TMUX" ] && return
  if [ -n "$1" ]; then
    tmux rename-session "$1"
  else
    tmux command-prompt -I "#S" -p "Rename session:" "rename-session %%"
  fi
}
trw() {
    [ -z "$TMUX" ] && return
    if [ -n "$1" ]; then
        tmux rename-window "$1"
    else
        tmux command-prompt -I "#W" -p "Rename window:" "rename-window %%"
    fi
}

# Whats My IP
alias wmi='dig +short myip.opendns.com @resolver1.opendns.com'

# Mac
if [ `uname` = "Darwin" ]; then
    alias o='open'
    alias pbc='pbcopy'
    alias pbp='pbpaste'
fi

# File Download
alias get='curl --continue-at - --location --progress-bar --remote-name --remote-time'

# Resource Usage
alias df='df -kh'
alias du='du -kh'

# Docker
alias d='docker'
alias dc='docker-compose'
# alias ecrl='$(aws ecr get-login --no-include-email)'

# Grep Colors
alias grep='grep --color=auto'

# Brew
if [ `uname` = "Darwin" ]; then
    alias brews='brew list -1'
    alias bubo='brew update && brew outdated'
    alias bubc='brew upgrade && brew cleanup'
    alias bubu='bubo && bubc'
    alias brewski='brew update && brew upgrade && brew cleanup; brew doctor'
fi

# Fix date on mac (requires coreutils - `brew install coreutils`)
if [ `uname` = "Darwin" ]; then
    if type -p gdate &>/dev/null; then
        alias date=gdate
    fi
fi

# Only define pbcopy / pbpaste if they don't already exist
if ! command -v pbcopy >/dev/null 2>&1; then
    pbcopy() {
        local data
        data=$(base64 | tr -d '\n')
        printf '\033]52;c;%s\a' "$data"
    }
fi

if ! command -v pbpaste >/dev/null 2>&1; then
    pbpaste() {
        # Request clipboard contents via OSC 52
        # WezTerm responds by pasting it into the terminal
        printf '\033]52;c;?\a'
    }
fi

# Emacs
alias pemacs='emacs -Q -l ~/.emacs.d/profile-dotemacs.el --eval "(setq profile-dotemacs-file (setq load-file-name \"~/.emacs.d/init.el\"))" -f profile-dotemacs'

# GAM (Google Workspace admin), if installed in ~/bin/gam7
[ -x "$HOME/bin/gam7/gam" ] && alias gam="$HOME/bin/gam7/gam"

alias nuc='mosh nuc'

nuctunnel() {
    if [ -z "$1" ]; then
        echo "Usage: nuctunnel <port>" >&2
        return 1
    fi
    local port="$1"

    ssh -N -o ExitOnForwardFailure=yes -o ConnectTimeout=5 \
        -L "${port}:localhost:${port}" nuc &
    local ssh_pid=$!

    local tries=0
    while ! nc -z localhost "$port" 2>/dev/null; do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            wait "$ssh_pid" 2>/dev/null
            echo "Error: failed to establish tunnel to nuc" >&2
            return 1
        fi
        tries=$((tries + 1))
        if [ "$tries" -gt 100 ]; then
            kill "$ssh_pid" 2>/dev/null
            wait "$ssh_pid" 2>/dev/null
            echo "Error: timeout waiting for tunnel on port ${port}" >&2
            return 1
        fi
        sleep 0.1
    done

    echo "Ready..."
    trap 'kill "$ssh_pid" 2>/dev/null' INT
    wait "$ssh_pid"
    trap - INT
}
