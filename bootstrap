#!/bin/sh
# Bootstrap dotfiles on a new machine (macOS or Linux).
#
#   curl -fsSL https://raw.githubusercontent.com/iantruslove/dotfiles/master/bootstrap | sh
#
# Installs git and stow, clones (or updates) ~/.dotfiles, and stows packages.
set -e

REPO_HTTPS=https://github.com/iantruslove/dotfiles.git
REPO_SSH=git@github.com:iantruslove/dotfiles.git
DOTFILES=$HOME/.dotfiles

have() { command -v "$1" >/dev/null 2>&1; }

# 1. git and stow
if [ "$(uname)" = "Darwin" ]; then
  if ! have brew; then
    NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      [ -x "$b" ] && eval "$("$b" shellenv)" && break
    done
  fi
  for pkg in git stow; do
    brew list --formula "$pkg" >/dev/null 2>&1 || brew install "$pkg"
  done
elif ! have git || ! have stow; then
  if have apt-get; then
    sudo apt-get update -qq && sudo apt-get install -y git stow
  elif have dnf; then
    sudo dnf install -y git stow
  elif have pacman; then
    sudo pacman -S --noconfirm --needed git stow
  elif have pkg; then
    sudo pkg install -y git stow
  else
    echo "Please install git and stow, then re-run." >&2
    exit 1
  fi
fi

# 2. Clone or update. Fetch over HTTPS (works before SSH keys exist), push over SSH.
if [ -d "$DOTFILES/.git" ]; then
  git -C "$DOTFILES" pull --quiet --ff-only
else
  git clone --quiet "$REPO_HTTPS" "$DOTFILES"
  git -C "$DOTFILES" remote set-url --push origin "$REPO_SSH"
fi

# 3. Stow packages
"$DOTFILES/install"

# 4. Things the configs expect but don't install themselves
if have tmux && [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone --quiet https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  echo "Installed tpm; press <prefix> I inside tmux to install plugins."
fi

if have emacs && [ ! -e "$HOME/.emacs.d" ]; then
  git clone --quiet --depth 1 https://github.com/syl20bnr/spacemacs "$HOME/.emacs.d"
  echo "Installed Spacemacs; the first Emacs start installs its packages."
fi

# Ghostty only sets TERMINFO for its own children, so processes started
# elsewhere (e.g. the Emacs daemon behind `emacsclient -t`) can't find
# xterm-ghostty. Compile it into ~/.terminfo, which everything searches.
GHOSTTY_TERMINFO=/Applications/Ghostty.app/Contents/Resources/terminfo
if [ -d "$GHOSTTY_TERMINFO" ] && ! TERMINFO= infocmp -x xterm-ghostty >/dev/null 2>&1; then
  TERMINFO=$GHOSTTY_TERMINFO infocmp -x xterm-ghostty | tic -x - 2>/dev/null
  echo "Installed the xterm-ghostty terminfo entry into ~/.terminfo."
fi

echo
echo "Done. Manual follow-ups (see README):"
have zsh || echo "  - install zsh"
case "$SHELL" in */zsh) ;; *) echo "  - chsh -s \"\$(command -v zsh)\"" ;; esac
[ -f "$HOME/.git_identities/.gitconfig" ] || \
  echo "  - create ~/.git_identities/.gitconfig (git refuses to commit without an identity)"
for tool in fzf zoxide herdr; do
  have "$tool" || echo "  - optional: install $tool"
done
